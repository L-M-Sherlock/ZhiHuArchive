    "headline": "学校≠教育≠技能；文凭溢价=80%信号传递+20%人力资本",
    "id": "4c592f496dc33822b560b382907ff1d0",
    "is_advertiser": false,
    "is_org": false,
    "is_privacy": false,
    "name": "Thoughts Memo",
    "type": "people",
    "url": "https://www.zhihu.com/api/v4/people/4c592f496dc33822b560b382907ff1d0",
    "url_token": "L.M.Sherlock",
