              "2044721377983326125"
            ]
          },
          "start_index": 2
        }
      ],
      "pid": "O7FsYKCO",
      "text": "* 起因是该女生父母反对该女生和男友恋爱，所以要把女生关进集中营"
    },
    {
      "marks": [
        {
          "end_index": 19,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 16,
