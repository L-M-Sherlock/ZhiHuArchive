              "2044423962214527346"
            ]
          },
          "start_index": 1
        }
      ],
      "pid": "-rBDRLzf",
      "text": "* 在车上上厕所要“尿进盆里”"
    },
    {
      "marks": [
        {
          "end_index": 41,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 94,
            "my_comment_count": 0,
