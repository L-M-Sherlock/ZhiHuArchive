            "like_count": 31,
            "my_comment_count": 0,
            "seg_ids": [
              "2073073554833392036"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "jCKEb-UL",
      "text": "整了个烂活，在知乎上被笑话，然后还回去写了个注释版，开篇这样说："
    },
    {
      "marks": [
        {
          "end_index": 25,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 8,
            "my_comment_count": 0,
            "seg_ids": [
              "2073073554833392036"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "z8U2NgPA",
      "text": "装啥呢老弟？做题做出幻觉了？真以为自己能睥睨天下？"
    },
    {
      "marks": [
        {
          "end_index": 45,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 9,
            "my_comment_count": 0,
            "seg_ids": [
              "2072027745287251961"
            ]
          },
          "start_index": 29
        }
      ],
      "pid": "PWCusuWe",
      "text": "我对他的评价还是：做题做魔怔了。当然也有炒作的成分，只不过没点真情流露还真达不到这个水平。"
    },
    {
      "marks": [
        {
          "end_index": 112,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 21,
            "my_comment_count": 0,
            "seg_ids": [
              "2075210659839611383"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "ohoy3EpA",
      "text": "一方面是长期的做题训练压抑本性，在本该乱搞的年纪憋着，连了解女生的机会都没有，更别说健身打扮了。越不乱搞越不知道该怎么乱搞，本来就是很扭曲很极端的那类人，长期得不到排解，最后憋久了更扭曲了，然后考到清华姚班那种地方，养蛊呢？"
    },
    {
      "marks": [
        {
          "end_index": 47,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 16,
            "my_comment_count": 0,
            "seg_ids": [
              "2076668733700032485"
            ]
          },
          "start_index": 5
        },
        {
          "end_index": 86,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 14,
            "my_comment_count": 0,
            "seg_ids": [
              "2072671489107695421"
            ]
          },
          "start_index": 48
        }
      ],
      "pid": "YLDMNpYa",
      "text": "另一方面，做题让他获得了自己本来不配拥有的优越感和自尊心，失去了一个人原本应该拥有的谦逊和敬畏。在学校虚假的评价体系中长期胜出让他觉得自己可以俯视所有的生命形式和生活方式，产生了「老子天下第一女人都该来舔我」的幻觉。"
    },
    {
      "marks": [
        {
          "end_index": 69,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 32,
            "my_comment_count": 0,
            "seg_ids": [
              "2070718675343168298"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "fJ4g2xPm",
      "text": "结果现实里只有郭菊阳这类拜金女会主动找他，于是感叹道：「原来女人都是这样的！」。属于是拿着锤子看哪里都像是钉子，自己是嫖客看谁都像是妓女。"
    },
    {
      "marks": [
        {
          "end_index": 90,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 22,
            "my_comment_count": 0,
            "seg_ids": [
              "2072459665741550583"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "UCnMj1k0",
      "text": "至于他骂清华的那些，我感觉骂的都挺对的，但他底线比我低，所以骂得比我狠。只能说恶人还需恶人磨。可惜这次他没骂到点子上，他要是说北京卷的事情那 Thoughts Memo 立马跟团。"
    }
