            "my_comment_count": 0,
            "seg_ids": [
              "2096938984626721811"
            ]
          },
          "start_index": 6
        }
      ],
      "pid": "_aIvZZfp",
      "text": "招笑。评价为「拴小孩拴上瘾了」。"
    },
    {
      "marks": [
        {
          "end_index": 73,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 2,
            "is_like": false,
            "is_span": false,
            "like_count": 26,
            "my_comment_count": 0,
            "seg_ids": [
              "2096849834946859317"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "Ld8k0yaB",
      "text": "至于鼓励青少年早睡早起更是典中典。我都说了多少遍了，「青少年晚起有利于身体健康！」「青少年晚起有利于身体健康！」「青少年晚起有利于身体健康！」……"
    },
    {
      "marks": [
        {
          "end_index": 34,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 2,
            "is_like": false,
            "is_span": false,
            "like_count": 26,
            "my_comment_count": 0,
            "seg_ids": [
              "2096514572039600082"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "aDw6k3aK",
      "text": "很多成年人有一个根深蒂固的偏见：早起等于勤奋自律，晚起等于懒惰堕落。但如果稍微了解一点睡眠神经科学，就会知道强迫二十岁左右的年轻人早起，完全是在违背自然规律。青少年本来就困的晚。[1]"
    },
    {
      "marks": [
        {
          "end_index": 36,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 19,
            "is_like": false,
            "is_span": false,
            "like_count": 22,
            "my_comment_count": 0,
            "seg_ids": [
              "2096617080594478663"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "zBRg8Y9o",
      "text": "所以说青少年晚起晚睡本就是天经地义，真不知道为啥某些老登总想要倒反天罡。"
    },
    {
      "marks": [
        {
          "end_index": 10,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 1,
            "is_like": false,
            "is_span": false,
            "like_count": 3,
            "my_comment_count": 0,
            "seg_ids": [
              "2096349323030180031"
            ]
          },
          "start_index": 3
        }
      ],
      "pid": "OyjT36Tb",
      "text": "另外，强迫青少年早期的后果极其严重。因为睡觉不是浪费时间，睡觉时大脑在整理白天的记忆。[2]"
    },
    {
      "marks": [
        {
          "end_index": 153,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 1,
            "is_like": false,
            "is_span": false,
            "like_count": 0,
            "my_comment_count": 0,
            "seg_ids": [
              "2096264813974402969"
            ]
          },
          "start_index": 141
        }
      ],
      "pid": "cvGC2hcn",
      "text": "对 33,818 名大学生的成绩分析表明，他们每周上早课的天数与平均绩点呈负相关。[3]每周不上早课、或只上 1 次早课的大学生，绩点最高；每周上 4～5 次早课的大学生，绩点最低。\n进一步利用学校的 Wi-Fi 连接日志和学习管理系统数据，研究者发现早课主要通过三种机制损害学业：一是早课导致更高的缺勤率；二是早起引发的「社交时差」削弱了白天的警觉性与认知表现；三是长期的睡眠剥夺直接阻碍了夜间的记忆巩固过程。[4]"
    },
    {
      "marks": [
        {
          "end_index": 51,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 2,
            "is_like": false,
            "is_span": false,
            "like_count": 19,
            "my_comment_count": 0,
            "seg_ids": [
              "2097106249989076169"
            ]
          },
          "start_index": 3
        }
      ],
      "pid": "zxzcKNA1",
      "text": "而且，光阴本就是用来浪费的。不在宿舍里浪费光阴，那你去教室里听别人在台上念 PPT 不照样是浪费光阴？"
    },
    {
      "marks": [
        {
          "end_index": 111,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 1,
            "is_like": false,
            "is_span": false,
            "like_count": 9,
            "my_comment_count": 0,
            "seg_ids": [
              "2096959907564205525"
            ]
          },
          "start_index": 79
        }
      ],
      "pid": "6xqDrJDd",
      "text": "在认知科学领域，被动接收信息的学习方式早就臭名昭著了。诺贝尔物理学奖得主 Carl Wieman 甚至毫不留情地指出：传统的讲课，就是教育界的「放血疗法」。[6]马斯克也说过，学校上课就是马戏团表演[7]，交钱看小丑说是。"
    },
    {
      "marks": [
        {
          "end_index": 32,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 14,
            "my_comment_count": 0,
            "seg_ids": [
              "2097238433743763406"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "xwqySO1-",
      "text": "我再重复一遍这句话：一切学习本质上都是在自学，总指望别人是没用的。"
    },
    {
      "marks": [
        {
          "end_index": 56,
          "is_annotation": false,
          "seg_info": {
            "comment_count": 0,
            "is_like": false,
            "is_span": false,
            "like_count": 7,
            "my_comment_count": 0,
            "seg_ids": [
              "2096540337862976157"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "PaB9pR4d",
      "text": "真正的教育需要培养人的能动性（Agency），说白了就是自己做决定、自己尝试、自己搞砸，然后自己承担后果的能力。[14]正如新闻里那几位大一新生所说，没课的时间，他们可以用来去图书馆自修、去探索城市，哪怕只是在寝室里发呆、睡个好觉、摸索自己真正感兴趣的方向，那都是属于他们自己的人生必经之路。"
    }
  ],
