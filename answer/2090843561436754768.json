              "2091254086758932527"
            ]
          },
          "start_index": 0
        }
      ],
      "pid": "-ArGLtet",
      "text": "明火危害人身安全，所以接下来应该规定「灶台不能放家里，也要拆下来上交学校」"
    },
    {
      "marks": [
        {
          "end_index": 50,
          "is_annotation": false,
          "seg_info": {
