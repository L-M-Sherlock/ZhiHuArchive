            "like_count": 2,
            "comment_count": 0,
            "my_comment_count": 0,
            "is_span": false
          }
        }
      ]
    },
    {
      "pid": "CFh-8mBC",
      "text": "假如大脑真把词语当作纯粹的逻辑构造，当作亚里士多德式的类别，并且 你永远不从中取出比你放进去更多的信息[1]，才会成立。",
