            "is_like": false,
            "like_count": 0,
            "comment_count": 1,
            "my_comment_count": 0,
            "is_span": false
          }
        }
      ]
    },
    {
      "pid": "ync952gT",
      "text": "有一种普遍的误解，就是以为你可以随心所欲地定义一个词。",
      "marks": [
        {
          "start_index": 0,
          "end_index": 27,
          "seg_info": {
            "seg_ids": [
              "2047340970245674268"
            ],
